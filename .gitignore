# Downloaded ACC dedicated server — do not redistribute.
# Fetch via: steamcmd +@sSteamCmdForcePlatformType windows \
#            +force_install_dir ./acc-server +login <user> \
#            +app_update 1430110 validate +quit
acc-server/

# Dirty reverse-engineering notes — must never be published.
# Contains offsets, disassembly excerpts, decompiled pseudocode,
# strings extracted from accServer.exe, Ghidra project files, etc.
notebook-a/

# Scratch directory: writable Ghidra install, temp logs, etc.
# Not part of the project, not redistributable.
tmp/

# Auto-generated session result files
accd/results/

# Typical local build / tool artifacts
target/
build/
*.o
*.obj
*.pdb
*.gpr
*.rep
*.rep.bak
.vscode/
.idea/
accd/cfg/

# Test cfg: track the static config files, ignore mutable / generated.
# accd runs directly against some cfg_* fixture dirs (-c cfg_next_race)
# and writes ratings back into them at shutdown, so a test run dirties
# the working tree.  The seeds are inert there anyway: those overlays
# set every rating requirement to 0, so nothing gates on them, and
# ratings_load just returns when the file is absent.
accd/tests/integration/cfg/ratings.json
accd/tests/integration/cfg_next_race/ratings.json
accd/tests/integration/cfg/current/
accd/tests/integration/cfg/*.bak

# Test run artifacts: pcap captures, logs, cached bytecode, result tables
accd/tests/integration/*.pcap
accd/tests/integration/*.log
accd/tests/integration/__pycache__/
accd/tests/integration/matrix_results.tsv
